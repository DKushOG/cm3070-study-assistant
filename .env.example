# Copy this file to .env. The defaults below run everything locally through
# Ollama and need no editing.

# --- Endpoint and models ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Text model. Build it first with: ollama create llama3.2-ctx16k -f Modelfile
# It is plain llama3.2 with the context window pinned to 16,384 tokens.
OPENAI_MODEL=llama3.2-ctx16k

# Vision model for slide images. Pull it with: ollama pull qwen2.5vl:7b
# Any Ollama vision model works here, with no code change.
VISION_MODEL=qwen2.5vl:7b

# Whisper size for transcription: tiny, base, small or medium.
WHISPER_MODEL=base

# Where runs are saved.
# OUTPUT_DIR=outputs

# --- Slide rendering (defaults shown) ---
# VISION_DPI=150
# VISION_MAX_PAGES=200

# --- Per-slide routing ---
# A slide goes to the vision model when pictures cover at least 10 per cent of
# it (PowerPoint), or when its text layer holds fewer than 60 words (PDF). The
# thresholds live in modules/slide_routing.py. Override them only for an
# experiment:
# SLIDE_ROUTING_PICTURE_THRESHOLD=0.10
# SLIDE_ROUTING_WORDS_THRESHOLD=60

# --- Sampling controls (unset by default) ---
# When unset they are not sent to the model at all. Set them to make a run
# repeatable:
# LLM_TEMPERATURE=0
# LLM_SEED=42

# Seconds allowed for one model call. Default 600.
# LLM_TIMEOUT=600

# --- Long inputs (unset by default) ---
# Per-source word cap for the prompt context. Unset means no limit. When set,
# each source is shortened on its own and the shortening is reported on screen
# and in the saved output.
# MAX_CONTEXT_WORDS=4000

# --- Quiz generation ---
# Attempts for the quiz call. Default 1, which generates once with no retry.
# Raise it to regenerate a quiz that fails the format check, using the same
# prompt. The check runs either way.
# QUIZ_MAX_ATTEMPTS=3

# The interface generates the quiz under a JSON schema, which fixes the five
# questions and the allowed source labels, and it can be switched off in the
# sidebar. The batch runner uses the original prompt-only path unless this is
# set to 1. Setting it to 0 also starts the interface on that path.
# QUIZ_STRUCTURED=1
